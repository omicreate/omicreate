    "@types/node": "^22.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "fast-check": "^4.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.0.1"
  }
